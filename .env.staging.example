# Copie para .env.staging na raiz do repositório (não commitar).
# Usado junto com: docker compose -f docker-compose.yml -f docker-compose.staging.yml up --build
#
# O Compose carrega .env primeiro e depois este arquivo — aqui só o que MUDA em relação ao ambiente de staging.

# --- Obrigatório ajustar: MySQL que recebeu o dump da produção (miniatura) ---
QUARKUS_DATASOURCE_JDBC_URL=jdbc:mysql://SEU_HOST_STAGING:3306/aerosuite?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo&characterEncoding=UTF-8&useUnicode=true&connectionCollation=utf8mb4_unicode_ci
# QUARKUS_DATASOURCE_USERNAME=...
# QUARKUS_DATASOURCE_PASSWORD=...

# --- URL do front que testadores usam (links em e-mail, etc.) ---
FRONTEND_URL=http://localhost:8081

# --- E-mail: evitar disparo real em staging ---
MAIL_MOCK=true

# --- Flyway: em staging costuma ajudar a recuperar histórico após testes quebrados ---
QUARKUS_FLYWAY_REPAIR_AT_START=true

# --- JWT: use segredo próprio de staging (nunca o de produção) ---
# AERO_SUITE_JWT_SECRET=

# --- Bling homologação (copie CLIENT_ID/SECRET do .env ou do app Bling) ---
# AERO_SUITE_BLING_ENABLED=true
# AERO_SUITE_BLING_CLIENT_ID=
# AERO_SUITE_BLING_CLIENT_SECRET=
# AERO_SUITE_BLING_REDIRECT_URI=https://app.aerosuite.com.br/api/integracoes/bling/oauth/callback
# AERO_SUITE_BLING_WEBHOOK_ENABLED=true
# AERO_SUITE_BLING_SYNC_ENABLED=true
# AERO_SUITE_SECRETS_KEY=

# --- Billing staging local ---
# AERO_SUITE_BILLING_PROVIDER=mock
