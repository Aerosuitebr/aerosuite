# Copie para .env.production na raiz (não commitar). Sobrescreve .env em produção.
# Guia: docs/DEPLOY-PRODUCAO.md

# --- URL pública (links em e-mail, redirects) ---
FRONTEND_URL=https://app.aerosuite.app

# --- Identificação do ambiente (banner UI + emissor no autenticador MFA) ---
# Produção Vultr (prod.aerosuite.com.br):
# AERO_SUITE_ENVIRONMENT_NAME=Aero Suite PROD
# AERO_SUITE_ENVIRONMENT_KIND=production
# AERO_SUITE_PLATFORM_OPS_MFA_ISSUER=Aero Suite PROD · Controle
# Homolog PC (app.aerosuite.com.br):
# AERO_SUITE_ENVIRONMENT_NAME=Aero Suite HML
# AERO_SUITE_ENVIRONMENT_KIND=homolog

# --- MySQL na rede Docker (overlay local-mysql) ---
QUARKUS_DATASOURCE_JDBC_URL=jdbc:mysql://mysql:3306/aerosuite?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo&characterEncoding=UTF-8&useUnicode=true&connectionCollation=utf8mb4_unicode_ci
QUARKUS_DATASOURCE_USERNAME=root
# QUARKUS_DATASOURCE_PASSWORD=  # use MYSQL_ROOT_PASSWORD forte (local-mysql) ou user dedicado

# --- MySQL gerido externo (sem local-mysql): descomente e ajuste ---
# QUARKUS_DATASOURCE_JDBC_URL=jdbc:mysql://SEU_HOST:3306/aerosuite?useSSL=true&serverTimezone=America/Sao_Paulo&characterEncoding=UTF-8&useUnicode=true&connectionCollation=utf8mb4_unicode_ci

# --- Segredos (obrigatório em produção) ---
# AERO_SUITE_JWT_SECRET=  # mín. 32 caracteres, gerado aleatoriamente
# QUARKUS_MAILER_PASSWORD=  # senha de app Google (conta contato@)

# --- Flyway: em produção preferir false após primeira subida limpa ---
QUARKUS_FLYWAY_REPAIR_AT_START=false

# --- E-mail real (não usar MAIL_MOCK em produção) ---
# MAIL_MOCK=false

# --- Raiz de dados no host Linux (opcional; default /var/aerosuite) ---
# AEROSUITE_DATA_ROOT=/var/aerosuite

# --- MySQL no Compose ---
# MYSQL_ROOT_PASSWORD=

# --- Billing Stripe (produção) — ver docs/STRIPE-PRODUCAO.md ---
# AERO_SUITE_BILLING_PROVIDER=stripe
# AERO_SUITE_STRIPE_SECRET_KEY=sk_live_...
# AERO_SUITE_STRIPE_WEBHOOK_SECRET=whsec_...
# AERO_SUITE_STRIPE_PRICE_ID=price_...
# AERO_SUITE_STRIPE_SUCCESS_URL=https://app.aerosuite.app/organizacoes?billing=ok
# AERO_SUITE_STRIPE_CANCEL_URL=https://app.aerosuite.app/organizacoes?billing=cancel

# --- Bling webhooks (P5.5) — ver docs/COMERCIALIZACAO-BLING-ESCOPO.md ---
# AERO_SUITE_BLING_ENABLED=true
# AERO_SUITE_BLING_CLIENT_SECRET=   # validação HMAC X-Bling-Signature-256
# AERO_SUITE_BLING_WEBHOOK_ENABLED=true

# --- WhatsApp / Evolution API ---
# Subir Evolution no mesmo host: docker-compose.production-evolution.yml
# EVOLUTION_API_KEY=                    # chave global Evolution (AUTHENTICATION_API_KEY)
# AERO_SUITE_EVOLUTION_ENABLED=true
# AERO_SUITE_EVOLUTION_API_BASE_URL=http://evolution-api:8080
# AERO_SUITE_EVOLUTION_ADMIN_API_KEY=   # mesmo valor que EVOLUTION_API_KEY
# AERO_SUITE_EVOLUTION_WEBHOOK_BASE_URL=https://api.seudominio.com
# AERO_SUITE_EVOLUTION_PUBLIC_URL=https://evolution.seudominio.com
# WHATSAPP_API_ENABLED=true

# Contato publico aerosuite.com.br (QR, envio unico ao comercial e desconexao)
# AERO_SUITE_MARKETING_WHATSAPP_ENABLED=true
# AERO_SUITE_MARKETING_WHATSAPP_DESTINATION_PHONE=5521990403514
