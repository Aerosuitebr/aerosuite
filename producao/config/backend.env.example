# Configurações do Backend - Ambiente de Produção
# Copie este arquivo para backend.env e configure com seus valores

# Banco de Dados
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/aerosuite
QUARKUS_DATASOURCE_USERNAME=aerosuite_user
QUARKUS_DATASOURCE_PASSWORD=sua_senha_aqui

# Porta HTTP do Backend (interna, não exposta diretamente)
QUARKUS_HTTP_PORT=8080

# Configurações de Email (Google Workspace — contato@ + alias noreply@)
QUARKUS_MAILER_HOST=smtp.gmail.com
QUARKUS_MAILER_PORT=587
QUARKUS_MAILER_FROM=noreply@aerosuite.com.br
QUARKUS_MAILER_USERNAME=contato@aerosuite.com.br
QUARKUS_MAILER_PASSWORD=sua_senha_de_app_google
QUARKUS_MAILER_SSL=false
QUARKUS_MAILER_START_TLS=REQUIRED
QUARKUS_MAILER_AUTH_METHODS=PLAIN

# Outras configurações
QUARKUS_LOG_LEVEL=INFO

