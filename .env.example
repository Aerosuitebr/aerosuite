# Copie para .env e preencha os valores. O .env é carregado pelo docker-compose (env_file).
# Não commitar o .env (deve estar no .gitignore).
# Após editar: .\scripts\validate-env.ps1
# Prefixo correcto: QUARKUS_* (nunca UARKUS_*).
#
# Staging: .env.staging.example → docs/OPERACAO-STAGING.md
# Producao: .env.production.example → docs/DEPLOY-PRODUCAO.md
#   docker compose -f docker-compose.yml -f docker-compose.local-mysql.yml -f docker-compose.production.yml up -d --build
# Indice: docs/PRODUTO-FINAL-INDICE.md

# Banco de dados (nome da BD: aerosuite)
# Se ainda existir a BD legada "bellows" com dados: db\scripts\Clone-BellowsDatabaseToAerosuite.ps1 -DropTarget -UpdateEnvFile
#
# Modo A — API no Docker + MySQL no host (Windows/Mac): use host.docker.internal na URL
# (127.0.0.1/localhost na URL = o próprio container da API, não o MySQL do host).
#   docker compose up --build
#
# Modo B — API + MySQL no Compose (BD vazio com bootstrap: EstruturaBanco + Flyway V2–V4):
#   docker compose -f docker-compose.yml -f docker-compose.local-mysql.yml up --build
#   Neste modo o JDBC por omissão aponta para o serviço "mysql"; pode omitir a linha abaixo
#   ou definir explicitamente:
#   QUARKUS_DATASOURCE_JDBC_URL=jdbc:mysql://mysql:3306/aerosuite?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo&characterEncoding=UTF-8&useUnicode=true&connectionCollation=utf8mb4_unicode_ci
#
# Modo C — API sem Docker (Quarkus dev na máquina): jdbc:mysql://127.0.0.1:3306/aerosuite?...
# Modo D — MySQL remoto: jdbc:mysql://IP_OU_HOST:3306/aerosuite?...
QUARKUS_DATASOURCE_DB_KIND=mysql
QUARKUS_DATASOURCE_JDBC_URL=jdbc:mysql://host.docker.internal:3306/aerosuite?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo&characterEncoding=UTF-8&useUnicode=true&connectionCollation=utf8mb4_unicode_ci
QUARKUS_DATASOURCE_USERNAME=root
QUARKUS_DATASOURCE_PASSWORD=root

# URL pública do frontend (QR do portal externo no Aero Studio, e-mails de senha, etc.).
# Não use localhost nem IP Docker (172.18.x) — clientes externos não alcançam.
# Local com Docker: https://app.aerosuite.app ou o domínio que o utilizador abre no browser.
FRONTEND_URL=https://app.aerosuite.app
# JWT interno (mín. 32 caracteres). Em produção: segredo forte e único.
AERO_SUITE_JWT_SECRET=dev-only-secret-change-in-production-min-32chars

# Plano de controle (fiscalização / infra SaaS) — e-mails autorizados, separados por vírgula
# PLATFORM_OPS_EMAILS=admin@aerosuite.com,ops@empresa.com
# PLATFORM_OPS_TOKEN_TTL_MINUTES=60
# PLATFORM_OPS_MFA_REQUIRED=true
# PLATFORM_OPS_MFA_REVALIDATE_MINUTES=30

# Só para docker-compose.local-mysql.yml (MySQL no Compose)
# MYSQL_ROOT_PASSWORD=root
# Porta no host (a API no Docker usa mysql:3306 na rede interna). Se 3306 estiver ocupada no host:
# MYSQL_PORT=3307

# Flyway: antes de migrate corre repair (histórico falhado / checksum alinhado ao JAR). Desactivar só se necessário.
# QUARKUS_FLYWAY_REPAIR_AT_START=false
# As migrações em backend/src/main/resources/db/migration aplicam-se automaticamente ao subir a API (ex.: V7 — inscrição municipal e e-mail NF-e em sistema_empresa_config).

# Google Workspace (contato@ + alias noreply@) — senha de app com 2FA ativo
QUARKUS_MAILER_HOST=smtp.gmail.com
QUARKUS_MAILER_PORT=587
QUARKUS_MAILER_FROM=noreply@aerosuite.com.br
QUARKUS_MAILER_USERNAME=contato@aerosuite.com.br
QUARKUS_MAILER_PASSWORD=sua_senha_de_app_google_aqui
QUARKUS_MAILER_SSL=false
QUARKUS_MAILER_START_TLS=REQUIRED
QUARKUS_MAILER_AUTH_METHODS=PLAIN
# Local/dev sem SMTP: defina true (equivale a quarkus.mailer.mock)
# MAIL_MOCK=true

# URL do frontend (links em e-mails, redirects).
# Docker local (nginx na porta 8081): http://localhost:8081
# Producao / Cloudflare: https://app.aerosuite.app
# FRONTEND_URL=http://localhost:8081

# Aero Suite — JWT interno (HS256). Mínimo 32 caracteres; em produção use um segredo forte e único.
# AERO_SUITE_JWT_SECRET=
#
# White-label em propostas (e-mail, PDF, WhatsApp) — alinhe ao frontend/src/assets/branding.json
# Marca comercial (fallback até o assistente "Configuração da empresa" gravar na tabela sistema_empresa_config — Flyway V6).
# AERO_SUITE_COMMERCIAL_DISPLAY_NAME=Aero Suite
# AERO_SUITE_COMMERCIAL_TAGLINE=Plataforma de gestão para oficinas MRO
# AERO_SUITE_COMMERCIAL_EMAIL_SUBJECT_SUFFIX=Aero Suite
# AERO_SUITE_COMMERCIAL_SUPPORT_EMAIL=comercial@suaempresa.com.br
#
# Pastas opcionais (Docker / deploy)
# PDFs do módulo Estoque — pasta manuals/ na raiz do repo (relativo) ou caminho absoluto em Docker (/app/manuals)
# AERO_SUITE_MANUALS_PATH=manuals
# AERO_SUITE_BIBLIOTECA_PATH=
# AERO_SUITE_BACKUP_HOST_EXPLORER_FOLDER=
#
# Logo e wordmark da empresa (upload autenticado em POST /api/sistema-empresa/logo|wordmark).
# A API grava ficheiros nesta pasta e expõe leitura pública em GET /api/public/empresa-asset/logo e .../wordmark.
# Omisso: pasta relativa "empresa-assets" ao processo da API. Em Docker, prefira caminho absoluto + volume
# (ex.: /data/empresa-assets) para persistir entre restarts.
# AERO_SUITE_EMPRESA_ASSETS_DIR=empresa-assets

# Billing — provedor: mock (dev), stripe (produção), pagarme (checkout + webhook)
# AERO_SUITE_BILLING_PROVIDER=mock
# Stripe (checkout real)
# AERO_SUITE_STRIPE_SECRET_KEY=
# AERO_SUITE_STRIPE_WEBHOOK_SECRET=
# AERO_SUITE_STRIPE_PRICE_ID=
# Pagar.me (payment link assinatura + webhook /api/billing/webhooks/pagarme)
# AERO_SUITE_PAGARME_SECRET_KEY=
# AERO_SUITE_PAGARME_PUBLIC_KEY=
# AERO_SUITE_PAGARME_WEBHOOK_SECRET=
# AERO_SUITE_PAGARME_BASE_URL=https://sdx-api.pagar.me/core/v5
# AERO_SUITE_PAGARME_PLAN_ID=
# AERO_SUITE_PAGARME_AMOUNT_CENTS=9900
#
# Bling ERP — OAuth multi-tenant (importar contatos na proposta)
# AERO_SUITE_BLING_ENABLED=true
# App Bling (plataforma): https://developer.bling.com.br/aplicativos
# AERO_SUITE_BLING_CLIENT_ID=
# AERO_SUITE_BLING_CLIENT_SECRET=
# Callback registrado no app Bling (ex.: https://api.seudominio.com/api/integracoes/bling/oauth/callback)
# AERO_SUITE_BLING_REDIRECT_URI=
# Legado Onda 1 (opcional, deprecado):
# AERO_SUITE_BLING_ACCESS_TOKEN=
# AERO_SUITE_BLING_API_BASE_URL=https://api.bling.com.br/Api/v3
# Cifra tokens OAuth em repouso (32+ chars; produção: segredo dedicado)
# AERO_SUITE_SECRETS_KEY=
# Webhook + fila de sync (contatos, pedidos — processamento assíncrono com retentativa)
# AERO_SUITE_BLING_WEBHOOK_ENABLED=true
# AERO_SUITE_BLING_SYNC_ENABLED=true
# Retorno do OAuth no frontend (padrão: /integracoes/bling) — propriedade aero.suite.bling.oauth.frontend-return-path
# Cache TTL da prontidão NF-e por tenant em segundos (padrão: 300) — aero.suite.bling.nfe-readiness.tenant-cache-ttl-sec
# Smoke local (scripts/test/api-bling-smoke.ps1): use um segredo dev-only, nunca o secret de produção
# AERO_SUITE_BLING_CLIENT_SECRET=dev-local-bling-webhook-smoke-secret-min-32ch

# WhatsApp / Evolution API (multi-tenant por oficina)
# Local com Docker: docker compose -f docker-compose.yml -f docker-compose.evolution.yml up -d --build
# EVOLUTION_API_KEY=aerosuite-evolution-api-key-2024
# WHATSAPP_API_ENABLED=true
# API no Docker: servico interno (NAO use localhost — quebra dentro do container)
# WHATSAPP_API_URL=http://evolution-api:8080
# WHATSAPP_API_TOKEN=aerosuite-evolution-api-key-2024
# AERO_SUITE_EVOLUTION_ENABLED=true
# AERO_SUITE_EVOLUTION_API_BASE_URL=http://evolution-api:8080
# AERO_SUITE_EVOLUTION_ADMIN_API_KEY=aerosuite-evolution-api-key-2024
# Webhook Evolution → API (rede Docker local; producao: https://api.seudominio.com)
# AERO_SUITE_EVOLUTION_WEBHOOK_BASE_URL=http://api:8080
# AERO_SUITE_EVOLUTION_SYNC_ENABLED=true
# AERO_SUITE_EVOLUTION_CONNECTION_SYNC_ENABLED=true
# Scripts E2E no host: EVOLUTION_API_URL=http://localhost:18082
# WHATSAPP_E2E_PHONE=5521999999999

# Modal público de demonstração: conecta, envia somente para o número comercial e desconecta.
# AERO_SUITE_MARKETING_WHATSAPP_ENABLED=true
# AERO_SUITE_MARKETING_WHATSAPP_DESTINATION_PHONE=5521990403514

# Testes / CI — ver docs/CI-SECRETS.md (AEROSUITE_TEST_*, AEROSUITE_DEMO_*, GitHub Actions)

# Testes multi-tenant (scripts/test/api-tenant-isolation.ps1 cenarios 5-6)
# Aplicar seed: .\scripts\test\provision-multi-tenant-login-test.ps1
# AEROSUITE_TEST_MULTI_TENANT_EMAIL=multi-tenant-test@aerosuite.local
# AEROSUITE_TEST_MULTI_TENANT_PASSWORD=admin123

# GitHub (opcional)
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
