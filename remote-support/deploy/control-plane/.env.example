# URL HTTPS pública do Control Plane, atrás de um proxy reverso.
AEROSUPPORT_CONTROL_PLANE_URL=https://support-api.example.com
AEROSUPPORT_OPERATOR_TOKEN=CHANGE_THIS_TO_AT_LEAST_32_RANDOM_CHARACTERS

# Configuração entregue aos RTCPeerConnection dos aplicativos.
# Troque domínio, usuário e senha antes de qualquer implantação.
AEROSUPPORT_ICE_SERVERS_JSON=[{"urls":["stun:turn.example.com:3478"]},{"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"],"username":"aerosupport","credential":"CHANGE_THIS_LONG_RANDOM_PASSWORD"}]
